; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="공백 (BLANK)"
config/description="패링 특화 2D 원히트 액션 — 시우 공방"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Config="*res://scripts/autoload/Config.gd"
Settings="*res://scripts/autoload/Settings.gd"
Debug="*res://scripts/autoload/Debug.gd"
GameState="*res://scripts/autoload/GameState.gd"
TimeManager="*res://scripts/autoload/TimeManager.gd"
Audio="*res://scripts/autoload/Audio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="disabled"

